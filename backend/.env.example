NODE_ENV=development
PORT=4000

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/leatherconnect?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
JWT_ACCESS_SECRET="replace-with-strong-random-secret"
JWT_REFRESH_SECRET="replace-with-different-strong-random-secret"
# FR-1.4 wants a 15m access token, but that only works once refresh-token
# rotation exists. Until then a long TTL avoids logging people out mid-drive.
# Set this back to 15m when the refresh flow lands.
JWT_ACCESS_TTL="8h"
JWT_REFRESH_TTL="30d"

# Cloudinary (document storage)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email provider
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="LeatherConnect <no-reply@leatherconnect.app>"

# Web Push (VAPID)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

CORS_ORIGIN="http://localhost:5173"
